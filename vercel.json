{
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "public",
  "functions": {
    "src/controllers/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "env": {
    "GEMINI_API_KEY": "@gemini_api_key"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
